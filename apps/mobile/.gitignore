# Build output (Vite) — regenerated by `bun run build` + `cap sync`.
www/

# kneecap M12/M13 — local output of scripts/build-android-release.sh /
# build-ios-unsigned-ipa.sh (and release.yml's staging step). Never
# committed; the real copies live as GitHub Release assets.
release-artifacts/

# Xcode / CocoaPods generated & user-specific files. The Xcode PROJECT itself
# (App.xcodeproj, Podfile, our custom Swift plugin sources) IS committed —
# only the Pods/ checkout and user state are not.
ios/App/Pods/
ios/App/build/
ios/App/DerivedData/
ios/App/App/public/
ios/**/*.xcuserstate
ios/**/xcuserdata/
ios/**/.DS_Store

# Gradle / Android Studio generated files. The Gradle PROJECT itself
# (build.gradle, our custom Kotlin plugin sources, AndroidManifest.xml) IS
# committed — only build output and local machine config are not.
android/.gradle/
android/build/
android/app/build/
android/app/src/main/assets/public/
android/local.properties
android/.idea/
android/**/*.iml
