<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- kneecap M3 item 6: FirstRunActivity is the launcher. It hands off
             to MainActivity at once (no visible flash). The first-run screen
             itself shows later, when the web app asks for it after "Sign in
             with publik" (PublikGatePlugin.showFirstRun), so the gate is the
             first screen of a new install. See FirstRunActivity.java. -->
        <activity
            android:name=".FirstRunActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <!-- The M1 spike's kneecap-spike:// deep link is a developer
                 tool: it is in src/debug/AndroidManifest.xml, so only debug
                 builds have it. -->
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- No CAMERA or RECORD_AUDIO: the app never asks for the camera or the
         microphone (the editor imports with the Photo Picker and has no
         recording). NativeBridgePlugin.kt still has the camera-capture path
         of plan M4 item 3, but no screen calls it; it needs CAMERA back
         before a screen does. Deliberately NOT declared either:
         READ_MEDIA_VIDEO / READ_MEDIA_IMAGES / READ_EXTERNAL_STORAGE — plan
         M4 item 2's chosen import path (Photo Picker + SAF fallback) needs
         neither; see FirstRunActivity.java's doc comment. -->
</manifest>
