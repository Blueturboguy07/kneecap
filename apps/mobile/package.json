{
	"name": "@kneecap/mobile",
	"version": "0.1.0",
	"private": true,
	"description": "kneecap: Capacitor 8 shell — iOS + Android native projects loading the real mobile editor (@kneecap/mobile-ui's EditorShell, wired to @kneecap/editor-core). See README.md. Developer tools (the #/diagnostics and #/autotest routes, the M1 spike screen spike.html) are only in a KNEECAP_DEBUG_TOOLS=1 build (bun run build:debug-tools), never in a release build.",
	"license": "MIT",
	"type": "module",
	"scripts": {
		"build": "vite build",
		"build:debug-tools": "KNEECAP_DEBUG_TOOLS=1 vite build",
		"dev": "vite",
		"check-types": "tsc --project tsconfig.json --noEmit",
		"cap:sync": "cap sync",
		"cap:sync:ios": "cap sync ios",
		"cap:sync:android": "cap sync android",
		"cap:open:ios": "cap open ios",
		"cap:open:android": "cap open android",
		"ios:build:sim": "bash scripts/build-ios-simulator.sh",
		"android:build:debug": "bash scripts/build-android-debug.sh",
		"ios:build:unsigned-ipa": "bash scripts/build-ios-unsigned-ipa.sh",
		"android:build:release": "bash scripts/build-android-release.sh"
	},
	"dependencies": {
		"@capacitor/android": "^8.0.0",
		"@capacitor/core": "^8.0.0",
		"@capacitor/ios": "^8.0.0",
		"@kneecap/editor-core": "workspace:*",
		"@kneecap/mobile-ui": "workspace:*",
		"@kneecap/native-bridge": "workspace:*",
		"mediabunny": "^1.29.1",
		"opencut-wasm": "file:../../rust/wasm/pkg",
		"react": "^19.0.0",
		"react-dom": "^19.0.0"
	},
	"devDependencies": {
		"@capacitor/cli": "^8.0.0",
		"@kneecap/editor-core": "workspace:*",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"typescript": "^5.8.3",
		"vite": "^7.0.0",
		"vite-plugin-wasm": "^3.6.0"
	}
}
