{
	"name": "@kneecap/mobile",
	"version": "0.1.0",
	"private": true,
	"description": "kneecap M3: Capacitor 8 shell — iOS + Android native projects loading a locally-bundled static harness. This is NOT the CapCut UI (that's M6-M8); it is the throwaway proof that the shell scaffold and the NativeBridge seam actually round-trip on device. See README.md. Also bundles the M1 spike diagnostics screen (src/spike/, spike.html) — throwaway, see docs/SPIKE-GUIDE.md.",
	"license": "MIT",
	"type": "module",
	"scripts": {
		"build": "vite build",
		"dev": "vite",
		"check-types": "tsc --project tsconfig.json --noEmit",
		"cap:sync": "cap sync",
		"cap:sync:ios": "cap sync ios",
		"cap:sync:android": "cap sync android",
		"cap:open:ios": "cap open ios",
		"cap:open:android": "cap open android",
		"ios:build:sim": "bash scripts/build-ios-simulator.sh",
		"android:build:debug": "bash scripts/build-android-debug.sh",
		"ios:build:unsigned-ipa": "bash scripts/build-ios-unsigned-ipa.sh",
		"android:build:release": "bash scripts/build-android-release.sh"
	},
	"dependencies": {
		"@capacitor/android": "^8.0.0",
		"@capacitor/core": "^8.0.0",
		"@capacitor/ios": "^8.0.0",
		"@kneecap/editor-core": "workspace:*",
		"@kneecap/native-bridge": "workspace:*",
		"mediabunny": "^1.29.1",
		"opencut-wasm": "^0.2.10"
	},
	"devDependencies": {
		"@capacitor/cli": "^8.0.0",
		"@kneecap/editor-core": "workspace:*",
		"typescript": "^5.8.3",
		"vite": "^7.0.0",
		"vite-plugin-wasm": "^3.6.0"
	}
}
